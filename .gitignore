# Host-fetched build inputs (see build/fetch-assets.sh) — large, never committed
build-assets/

# Locally installed toolchain for Hub tests (node/npm/esbuild) — never committed
.tools/

# Pinned upstream Hub source, ported by build/ubuntu-hub-source.py in CI — never committed
hub-source/

# Build logs
build/*.log

# Gate-test outputs
build/bootable.img
build/ovmf-vars.fd
build/qemu.pid
build/serial.log

# Python bytecode caches
__pycache__/
