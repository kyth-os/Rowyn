# Rowyn Plymouth boot splash: black background, centered static mark and spinner.
Window.SetBackgroundTopColor (0, 0, 0);
Window.SetBackgroundBottomColor (0, 0, 0);

logo.source = Image ("rowyn-logo.png");
spinner.source = Image ("rowyn-logo.png");
logo.image = logo.source;
spinner.image = spinner.source;
logo.sprite = Sprite (logo.image);
spinner.sprite = Sprite (spinner.image);
last_screen_w = -1;
last_screen_h = -1;

fun resize_splash () {
    screen_w = Window.GetWidth ();
    screen_h = Window.GetHeight ();
    if (screen_w > 0 && screen_h > 0 && (last_screen_w != screen_w || last_screen_h != screen_h)) {
        if (logo.source && logo.source.GetWidth () > 0 && logo.source.GetHeight () > 0) {
            max_size = 160;
            if (screen_w * 0.22 < max_size) max_size = screen_w * 0.22;
            if (screen_h * 0.22 < max_size) max_size = screen_h * 0.22;
            scale = max_size / logo.source.GetWidth ();
            if (logo.source.GetHeight () * scale > max_size) scale = max_size / logo.source.GetHeight ();
            logo.image = logo.source.Scale (logo.source.GetWidth () * scale, logo.source.GetHeight () * scale);
            logo.sprite.SetImage (logo.image);
        }
        if (spinner.source && spinner.source.GetWidth () > 0 && spinner.source.GetHeight () > 0) {
            spinner_size = 24;
            if (screen_w * 0.1 < spinner_size) spinner_size = screen_w * 0.1;
            if (screen_h * 0.1 < spinner_size) spinner_size = screen_h * 0.1;
            spinner_scale = spinner_size / spinner.source.GetWidth ();
            if (spinner.source.GetHeight () * spinner_scale > spinner_size) spinner_scale = spinner_size / spinner.source.GetHeight ();
            spinner.image = spinner.source.Scale (spinner.source.GetWidth () * spinner_scale, spinner.source.GetHeight () * spinner_scale);
            spinner.sprite.SetImage (spinner.image);
        }
        last_screen_w = screen_w;
        last_screen_h = screen_h;
    }
}

fun position_splash () {
    screen_w = Window.GetWidth ();
    screen_h = Window.GetHeight ();
    if (screen_w > 0 && screen_h > 0) {
        if (logo.image) {
            logo.sprite.SetX ((screen_w - logo.image.GetWidth ()) / 2);
            logo.sprite.SetY (screen_h / 2 - logo.image.GetHeight () / 2 - 18);
        }
        if (spinner.image) {
            spinner.sprite.SetX ((screen_w - spinner.image.GetWidth ()) / 2);
            spinner.sprite.SetY (screen_h / 2 + 38);
        }
    }
}

resize_splash ();
position_splash ();
frame = 0;
fun refresh_callback () {
    frame++;
    resize_splash ();
    position_splash ();
    if (spinner.image) {
        spinner.sprite.SetImage (spinner.image.Rotate (frame * 0.20944));
        spinner.sprite.SetX ((Window.GetWidth () - spinner.sprite.GetImage ().GetWidth ()) / 2);
        spinner.sprite.SetY (Window.GetHeight () / 2 + 38);
    }
}
Plymouth.SetRefreshFunction (refresh_callback);

# Preserve text notices used by first-boot and update flows.
msg_sprite = Sprite ();
msg_sprite.SetOpacity (0.0);
fun message_callback (text) {
    if (text != "") {
        img = Image.Text (text, 0.85, 0.86, 0.95, 1);
        if (img) {
            msg_sprite.SetImage (img);
            msg_sprite.SetX (Window.GetWidth () / 2 - img.GetWidth () / 2);
            msg_sprite.SetY (Window.GetHeight () * 0.68);
        }
        msg_sprite.SetOpacity (1.0);
    } else {
        msg_sprite.SetOpacity (0.0);
    }
}
Plymouth.SetMessageFunction (message_callback);
