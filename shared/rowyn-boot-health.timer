[Unit]
Description=Check Rowyn boot health once per boot

[Timer]
# Late enough for the desktop to settle and early enough that a broken image
# is noticed on the boot that needs noticing. No Persistent=: a run missed
# while powered off must not fire at an arbitrary later time.
OnBootSec=90s
AccuracySec=5s
Unit=rowyn-boot-health.service

[Install]
WantedBy=timers.target
